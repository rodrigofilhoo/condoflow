    "paths": {
        "/login": {
            "get": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Formulário de login",
                "description": "Formulário de login",
                "operationId": "showLoginForm",
                "responses": {
                    "200": {
                        "description": "Formulário exibido"
                    }
                }
            },
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Efetuar login",
                "description": "Envia código de 2FA por email",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "user@example.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "302": {
                        "description": "Redireciona para 2FA"
                    },
                    "422": {
                        "description": "Email inválido"
                    }
                }
            }
        },
        "/2fa": {
            "get": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Formulário de código 2FA",
                "description": "Formulário de 2FA",
                "operationId": "show2faForm",
                "responses": {
                    "200": {
                        "description": "Formulário exibido"
                    }
                }
            },
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Verificar código 2FA",
                "description": "Verificar código 2FA",
                "operationId": "verify2fa",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "two_factor_code": {
                                        "type": "string",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "302": {
                        "description": "Redireciona para dashboard"
                    },
                    "422": {
                        "description": "Código inválido"
                    }
                }
            }
        },
        "/2fa/resend": {
            "get": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Reenviar código 2FA",
                "description": "Reenviar código 2FA",
                "operationId": "resend2fa",
                "responses": {
                    "302": {
                        "description": "Código reenviado"
